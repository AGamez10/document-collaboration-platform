# =============================================================================
# Office Platform - Environment variables
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#   cp .env.example .env
# Every variable below has a fallback in `src/main/resources/application.yml`,
# so the stack boots without a `.env` for local development only.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=office_platform
POSTGRES_USER=office_platform
POSTGRES_PASSWORD=change-me

# --- MinIO (S3-compatible object storage) ------------------------------------
# Root credentials for the MinIO container. The application reads the same
# values through MINIO_ACCESS_KEY / MINIO_SECRET_KEY (wired in docker-compose).
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# --- OnlyOffice Document Server ----------------------------------------------
# Shared secret used to sign the JWT exchanged with the Document Server.
# Must match the JWT_SECRET of the onlyoffice container. Minimum 32 characters.
ONLYOFFICE_JWT_SECRET=change-me-at-least-32-characters-long
# Public URL the browser uses to reach the Document Server assets.
ONLYOFFICE_PUBLIC_URL=http://localhost:8081
# Max concurrent connections allowed against the Document Server.
ONLYOFFICE_MAX_CONNECTIONS=20

# --- Widget token -------------------------------------------------------------
# Secret used to sign the short-lived identity JWT handed to the embeddable
# widget. Minimum 32 characters for HS256. Never reuse the OnlyOffice secret.
WIDGET_TOKEN_SECRET=change-me-at-least-32-characters-long

# --- Application URLs ---------------------------------------------------------
# Internal URL the Document Server uses to call back into this service.
APP_INTERNAL_URL=http://localhost:8080
# Public base URL of this service (used to build the OnlyOffice callback URL).
OFFICE_PLATFORM_PUBLIC_URL=http://localhost:8080
# Comma-separated list of allowed CORS origins. Use explicit origins in production.
OFFICE_PLATFORM_CORS_ALLOWED_ORIGINS=*

# --- Storage limits -----------------------------------------------------------
# Total storage quota in bytes (default: 50 GB).
OFFICE_PLATFORM_MAX_TOTAL_SIZE=53687091200

# --- Backups ------------------------------------------------------------------
OFFICE_PLATFORM_BACKUP_PATH=backups
OFFICE_PLATFORM_BACKUP_AUTO_ENABLED=true
OFFICE_PLATFORM_BACKUP_INTERVAL_HOURS=24
OFFICE_PLATFORM_BACKUP_MAX_RETAINED=10
